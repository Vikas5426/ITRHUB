ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------------------
# Obtain your database URI from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
#
# Recommended (Transaction Pooler - IPv4 compatible & scalable):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Alternative (Direct Connection):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Note: If you copy the postgresql:// URL from the dashboard, ITRHUB automatically converts it to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Optional: Supabase Project API & Storage Keys (from Project Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------------------
# Application & Security Secrets
# ------------------------------------------------------------------------------
# Generate long, independent values for both secrets in production.
SECRET_KEY=replace-with-a-long-random-session-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-separate-long-random-document-secret
SECURE_COOKIES=false
AUTO_CREATE_TABLES=true
MAX_DOCUMENT_BYTES=10485760

# ------------------------------------------------------------------------------
# AI Configuration (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_REASONING_EFFORT=medium

